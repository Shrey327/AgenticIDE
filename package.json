{
  "name": "ai-engineering-ide",
  "version": "0.2.1",
  "private": true,
  "engines": {
    "node": ">=22.13.0 <25"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build:core": "node scripts/prepare-assets.mjs && npm run build -w @aiide/core",
    "build:extension": "npm run build:core && npm run build -w @aiide/theia-extension",
    "build": "npm run build:extension && npm run build -w @aiide/desktop",
    "build:browser": "npm run build:extension && npm run build -w @aiide/browser",
    "start": "npm run start -w @aiide/desktop --",
    "start:browser": "npm run start -w @aiide/browser --",
    "test": "npm run test -w @aiide/core && python3 -m unittest discover -s python/tests -v",
    "typecheck": "npm run build:extension",
    "collector:install": "node scripts/install-collector.mjs",
    "package": "npm run build && npm run package -w @aiide/desktop",
    "extensions:install": "node scripts/install-extensions.mjs",
    "test:ui": "node scripts/test-ui.mjs",
    "format": "prettier --write \"packages/*/src/**/*.{ts,tsx}\" \"scripts/*.mjs\"",
    "check:format": "prettier --check \"packages/*/src/**/*.{ts,tsx}\" \"scripts/*.mjs\"",
    "demo": "node scripts/start-demo.mjs",
    "test:runtime": "node scripts/test-runtime.mjs",
    "test:training": "node scripts/test-training.mjs",
    "test:wandb": "node scripts/test-wandb.mjs",
    "test:training:ui": "node scripts/test-training-ui.mjs",
    "test:agents": "node scripts/test-agent-access.mjs",
    "test:usability": "node scripts/test-usability.mjs",
    "test:voice:ui": "node scripts/test-voice-ui.mjs",
    "test:product:ui": "node scripts/test-product-ui.mjs",
    "test:memory:ui": "node scripts/test-memory-maintenance-ui.mjs",
    "test:eval:ui": "node scripts/test-eval-regression-ui.mjs",
    "test:sandboxes": "node scripts/test-sandboxes.mjs",
    "test:desktop": "node scripts/test-desktop.mjs",
    "test:documents:ui": "node scripts/test-documents-ui.mjs",
    "test:rag:lifecycle": "node scripts/test-rag-lifecycle.mjs",
    "test:advanced:rl": "node scripts/test-advanced-rl.mjs",
    "eval:gate": "node scripts/eval-gate.mjs",
    "test:workflows:ui": "node scripts/test-workflows-ui.mjs",
    "test:workflows:agents": "node scripts/test-workflow-agents.mjs",
    "test:huggingface": "node scripts/test-huggingface.mjs",
    "test:huggingface:ui": "node scripts/test-huggingface-ui.mjs",
    "test:production:voice": "node scripts/test-production-voice.mjs",
    "test:local:jobs": "node scripts/test-local-jobs.mjs",
    "test:voice:realtime:ui": "node scripts/test-realtime-voice-ui.mjs",
    "test:custom:rl": "node scripts/test-custom-rl.mjs",
    "test:custom:rl:ui": "node scripts/test-custom-rl-ui.mjs",
    "test:rag:semantic": "node scripts/test-semantic-retrieval.mjs",
    "test:sandboxes:vm": "node scripts/test-apple-sandbox.mjs",
    "test:sandboxes:vm:ui": "node scripts/test-apple-sandbox-ui.mjs",
    "test:sandboxes:vm:env": "node scripts/test-apple-sandbox-environment.mjs",
    "test:voice:reliability": "node scripts/test-production-voice.mjs --faults",
    "test:knowledge:graph:ui": "node scripts/test-knowledge-graph-ui.mjs",
    "test:evidence:ui": "node scripts/test-task-evidence-ui.mjs"
  },
  "devDependencies": {
    "@types/node": "22.15.30",
    "prettier": "3.6.2",
    "typescript": "5.9.3"
  }
}
